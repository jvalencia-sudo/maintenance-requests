# Copy this file to .env before running docker compose. Do not commit .env.

# Database
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=change_me
POSTGRES_DB=maintenance_requests

# Host ports (change them if they are already in use on your machine)
DB_PORT=5432
API_PORT=8080
WEB_PORT=3000

# API behaviour
APPLY_MIGRATIONS=true
SEED_DEMO_DATA=true
ENABLE_SWAGGER=true
# Must match the origin the web app is served from (http://localhost:${WEB_PORT}).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Web: the browser calls the API directly. Inlined at build time, so it must match
# http://localhost:${API_PORT}; rebuild the web image after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8080
